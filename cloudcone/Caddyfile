notify.dttutty.com {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        -Server
    }

    request_body {
        max_size 4KB
    }

    @notify path /visit /healthz
    handle @notify {
        reverse_proxy 127.0.0.1:8787
    }

    handle {
        respond 404
    }
}
